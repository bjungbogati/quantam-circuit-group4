        "# Qisket\n",
        "\n",
        "``` python\n",
        "from qiskit import QuantumCircuit, QuantumRegister\n",
        "\n",
        "qubits = QuantumRegister(2, name=\"q\")\n",
        "circuit = QuantumCircuit(qubits)\n",
        "\n",
        "q0, q1 = qubits\n",
        "\n",
        "circuit.h(q0)\n",
        "circuit.cx(q0, q1)\n",
        "circuit.measure_all()\n",
        "\n",
        "fig = circuit.draw(\"mpl\")\n",
        "fig\n",
        "```"
